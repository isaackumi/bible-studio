    "@lucide/svelte": "^1.57.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2",
    "paneforge": "^1.0.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
