{
  "name": "church-studio",
  "version": "0.1.0",
  "description": "Offline church presentation studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
