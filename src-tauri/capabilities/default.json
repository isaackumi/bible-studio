{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The operator desk: opens and closes the output windows, dialogs, links and updates",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
