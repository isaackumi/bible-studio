{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Operator and audience windows",
  "windows": ["main", "audience"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "dialog:default"
  ]
}
