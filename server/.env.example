# Settings for the license server (the Cloudflare Worker in this folder).
#
# In production, set the secrets with `npx wrangler secret put NAME` (deploy.sh sets the signing
# key, admin token and accounts secret for you) and the plain values in wrangler.jsonc "vars".
# For `npx wrangler dev`, copy this file to server/.dev.vars (never committed) and fill it in.
# Never put real values in this file.

# --- Secrets ---------------------------------------------------------------------------------
# Ed25519 key that signs licenses and leases (~/.church-studio/license-signing.key).
CHURCH_STUDIO_SIGNING_KEY=
# Opens /admin.
ADMIN_TOKEN=
# Signs account sessions (~/.church-studio/auth-secret.txt).
BETTER_AUTH_SECRET=
# Sends license keys and sign-in links (Resend › API Keys, sending access).
RESEND_API_KEY=
# Paddle server-side API key (Paddle › Developer tools › Authentication). Sandbox and live keys differ.
PADDLE_API_KEY=
# The webhook destination's secret key (Paddle › Developer tools › Notifications › the destination).
PADDLE_WEBHOOK_SECRET=
# Sign-in providers (optional; each appears once both values are set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Plain settings (wrangler.jsonc "vars") ------------------------------------------------
# "mock" (built-in test checkout, nothing charged) or "paddle".
BILLING_PROVIDER=mock
# "sandbox" or "live": which Paddle the API key, prices and client token belong to.
PADDLE_ENV=sandbox
# Paddle client-side token for the checkout page: test_... in sandbox, live_... in live.
PADDLE_CLIENT_TOKEN=
# Which Paddle price is which plan: price:plan:interval, comma separated.
PADDLE_PRICES=pri_xxx:premium:monthly,pri_xxx:premium:yearly,pri_xxx:church:monthly,pri_xxx:church:yearly
# Promo codes charged through Paddle discounts: CODE:dsc_xxx, comma separated.
PADDLE_DISCOUNTS=
MAIL_FROM=Church Studio <account@mail.heitechinc.com>
PUBLIC_URL=https://license.heitechinc.com
COMPANY_NAME=HeiTech
CONTACT_EMAIL=support@heitechinc.com
TRIAL_DAYS=14
LEASE_DAYS=30
GRACE_DAYS=7
