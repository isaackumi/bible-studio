// The license server on Cloudflare Workers: run `wrangler deploy` from this folder.
// Secrets are not kept here; set them once with `wrangler secret put` (see README.md).
{
  "name": "church-studio-keys",
  // HeiTech's Cloudflare account (not a secret), so the deploy pipeline needs only an API token.
  "account_id": "9c069a5afbfa4133f6a165e2adb7b316",
  "main": "paddle.ts",
  "compatibility_date": "2026-09-01",
  // Better Auth (accounts) uses Node's AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The web demo (church-studio.heitechinc.com/app): build it with `npm run build:web` before deploying.
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": true },
  // church-studio.heitechinc.com is the address people see: sign-in, checkout and the links in emails.
  // license.heitechinc.com is the address apps already installed talk to (src/lib/domain/billing.ts);
  // it stays, answering the same. The workers.dev address is off.
  "routes": [
    { "pattern": "church-studio.heitechinc.com", "custom_domain": true },
    { "pattern": "license.heitechinc.com", "custom_domain": true }
  ],
  "vars": {
    // "sandbox" while testing with Paddle's sandbox; "live" when selling for real.
    "PADDLE_ENV": "sandbox",
    // Which Paddle price grants which plan. PLACEHOLDER: put your price ids here.
    "PADDLE_PRICES": "pri_premium_monthly:premium,pri_premium_yearly:premium,pri_church_monthly:church,pri_church_yearly:church",
    // The sender of key emails and sign-in links. mail.heitechinc.com is verified in Resend (a
    // subdomain, so this mail never touches the company's own). Change the name with the app's.
    "MAIL_FROM": "Church Studio <account@mail.heitechinc.com>",
    "GRACE_DAYS": "7",
    // "mock" runs the built-in test checkout (no money moves); "paddle" sells for real through Paddle.
    // Changing provider later is this one line (plus that provider's secrets).
    "BILLING_PROVIDER": "mock",
    // Free trial length, and how long a computer may stay offline before it must check in.
    "TRIAL_DAYS": "14",
    "LEASE_DAYS": "30",
    // The public pages (home, terms, privacy, refunds): who sells, and an inbox someone reads.
    "COMPANY_NAME": "HeiTech",
    "CONTACT_EMAIL": "support@heitechinc.com",
    // Shown in the policies as the data controller's address, and the law the terms follow.
    // PLACEHOLDERS until HeiTech's registered details are confirmed (see docs/launch-checklist.md).
    "COMPANY_ADDRESS": "",
    "COMPANY_COUNTRY": "",
    // The address people see: sign-in pages, sign-in callbacks, checkout and the links in emails.
    "PUBLIC_URL": "https://church-studio.heitechinc.com",
    // Cloudflare Access in front of /admin (README › Admin): the team domain and the application's
    // AUD tag, both shown in Zero Trust. Not secrets. Empty: the admin page only opens to look.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "kv_namespaces": [
    // Everything the server keeps: seats, trials, checkouts, subscriptions, promo codes and check-ins.
    { "binding": "ACTIVATIONS", "id": "d2ceebbb59204d8bafd2b212caef5d0e" }
  ],
  "d1_databases": [
    // Accounts (auth.ts): Better Auth's users, sessions and sign-in links. Tables: auth-schema.sql.
    { "binding": "AUTH_DB", "database_name": "church-studio-auth", "database_id": "74ed8554-fac2-4318-bf45-0d01e95f57e6" }
  ]
}
